 class AgentScopeV1Test(unittest.IsolatedAsyncioTestCase):
+    async def test_core_post_tool_failure_retains_complete_result(self) -> None:
+        for failure_at in (1, 2):
+            with self.subTest(failure_at=failure_at):
+                calls = 0
+
+                async def post_tool(request):
+                    nonlocal calls
+                    calls += 1
+                    if calls == failure_at:
+                        raise core.TokenlessError("stash backend unavailable")
+                    return _post_response("compressed", "temporary hint")
+
+                self.integration.sdk.post_tool = post_tool
+                content = [
+                    {"type": "text", "text": "first original result"},
+                    {"type": "image", "source": {"url": "https://example.com/image"}},
+                    {"type": "text", "text": "second original result"},
+                ]
+                response = _Response(content, metadata={"success": True, "duration": 3})
+                registered = self.toolkit.tools["large_result"]
+                with self.assertLogs("tokenless_agentscope._v1", level="ERROR"):
+                    result = await registered.postprocess_func(
+                        {"name": "large_result", "id": "failed-compression", "input": {}},
+                        response,
+                    )
+
+                self.assertIs(result, response)
+                self.assertIs(result.content, content)
+                self.assertEqual(result.metadata, {"success": True, "duration": 3})
+                self.assertEqual(content[0]["text"], "first original result")
+                self.assertEqual(content[2]["text"], "second original result")
+                self.assertEqual(calls, failure_at)
+
+    async def test_unrelated_post_tool_errors_remain_visible(self) -> None:
+        async def post_tool(request):
+            raise ValueError("application contract failure")
+
+        self.integration.sdk.post_tool = post_tool
+        registered = self.toolkit.tools["large_result"]
+        with self.assertRaisesRegex(ValueError, "application contract failure"):
+            await registered.postprocess_func(
+                {"name": "large_result", "id": "unexpected-failure", "input": {}},
+                _Response([{"type": "text", "text": "original result"}]),
+            )
+
