+        if not restore_files:
+            log.info(f"no binlog files to replay,{self.get_log_comm()}")
+            return
+        if os.path.basename(restore_files[0]) != os.path.basename(binlog_file):
+            log.error(f"starting binlog {binlog_file} is unavailable,{self.get_log_comm()}")
+            raise ErrCodeException(MySQLErrorCode.SYSTEM_ERROR)
+
+        decoder_options = [
+            "--no-defaults",
+            "--disable-log-bin",
+            f"--start-position={start_position}",
+            f"--stop-datetime={stop_datetime}",
+        ]
+        if self.database:
+            decoder_options.append(f"--database={self.database}")
+        skip_gtids = self.get_skip_gtids_cmd()
+        if skip_gtids:
+            decoder_options.append(skip_gtids)
+
+        # Keep one client session across log rotations so temporary tables survive.
+        restore_cmd = (
+            "files=(); while IFS= read -r -d '' file; do "
+            'files+=("$file"); done < "$1" || exit $?; '
+            'user=$2 port=$3 host=$4; shift 4; '
+            'mysqlbinlog "$@" "${files[@]}" < /dev/null | '
+            'mysql -u "$user" -P "$port" -h "$host" -p'
+        )
