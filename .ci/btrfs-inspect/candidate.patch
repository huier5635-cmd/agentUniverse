+        warn!("--mount-path is only used by BtrfsLoop; BtrfsBase uses [backend.btrfs-base] btrfs_mount instead");
+    }
+    info!("Creating BtrfsBase backend at {:?} (CrossDisk default)", mount);
+    Arc::new(BtrfsBaseBackend::new(mount.to_path_buf(), BtrfsBaseScenario::CrossDisk))
