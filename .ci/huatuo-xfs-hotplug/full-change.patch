+func xfsHotplugMetrics(metrics []*metric.Data, device string) map[string]float64 {
+	values := make(map[string]float64)
+	for _, m := range metrics {
+		if m.Labels()["device"] == device {
+			values[m.Name()] = m.Value
+		}
+	}
+	return values
+}
