+    state.save_manifest().await.unwrap();
+    drop(state);
+    let restarted = resolve_state(&DaemonConfig::default(), temp.path())
+        .await
+        .unwrap();
+    assert_eq!(restarted.backend.data_root(), chosen.join("ws-ckpt-data"));
