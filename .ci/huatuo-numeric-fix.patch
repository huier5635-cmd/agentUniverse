diff --git a/internal/storage/driver/filter.go b/internal/storage/driver/filter.go
index cfea46f..69a0efc 100644
--- a/internal/storage/driver/filter.go
+++ b/internal/storage/driver/filter.go
@@ -15,8 +15,11 @@
 package driver
 
 import (
+	"encoding/json"
 	"fmt"
 	"math"
+	"strconv"
+	"strings"
 )
 
 // NormalizeFilterValue validates the operator and its operands and formats time
@@ -59,6 +62,8 @@ func NormalizeFilterValue(filter Filter) (any, error) {
 func normalizeComparisonValue(value any, ordered bool) (any, error) {
 	value = NormalizeValue(value)
 	switch v := value.(type) {
+	case json.Number:
+		return normalizeJSONNumber(v)
 	case string, int, int8, int16, int32, int64, uint, uint8, uint16, uint32, uint64:
 		return value, nil
 	case bool:
@@ -83,3 +88,25 @@ func normalizeComparisonValue(value any, ordered bool) (any, error) {
 
 	return nil, fmt.Errorf("%w: unsupported comparison value of type %T", ErrInvalidQuery, value)
 }
+
+func normalizeJSONNumber(number json.Number) (any, error) {
+	if json.Valid([]byte(number)) {
+		if strings.ContainsAny(number.String(), ".eE") {
+			value, err := number.Float64()
+			if err == nil && !math.IsNaN(value) && !math.IsInf(value, 0) {
+				return value, nil
+			}
+		} else {
+			// SQLite reads fields with UseNumber; integer predicates must not
+			// round through float64 when those values are used again.
+			if value, err := number.Int64(); err == nil {
+				return value, nil
+			}
+			if value, err := strconv.ParseUint(number.String(), 10, 64); err == nil {
+				return value, nil
+			}
+		}
+	}
+
+	return nil, fmt.Errorf("%w: JSON number %q is invalid or outside supported numeric ranges", ErrInvalidQuery, number)
+}
diff --git a/internal/storage/driver/filter_test.go b/internal/storage/driver/filter_test.go
index 2ce6eae..9cbeb7e 100644
--- a/internal/storage/driver/filter_test.go
+++ b/internal/storage/driver/filter_test.go
@@ -15,6 +15,7 @@
 package driver
 
 import (
+	"encoding/json"
 	"errors"
 	"math"
 	"reflect"
@@ -103,3 +104,55 @@ func TestNormalizeFilterValuePreservesInput(t *testing.T) {
 		t.Fatalf("input value was modified: %v", values)
 	}
 }
+
+func TestNormalizeFilterJSONNumbers(t *testing.T) {
+	for _, test := range []struct {
+		value json.Number
+		want  any
+	}{
+		{"0", int64(0)},
+		{"-0", int64(0)},
+		{"9007199254740993", int64(9007199254740993)},
+		{"-9223372036854775808", int64(math.MinInt64)},
+		{"9223372036854775807", int64(math.MaxInt64)},
+		{"18446744073709551615", uint64(math.MaxUint64)},
+		{"1.25", 1.25},
+		{"-1.25e-2", -0.0125},
+		{"2E3", float64(2000)},
+	} {
+		t.Run(test.value.String(), func(t *testing.T) {
+			got, err := NormalizeFilterValue(Filter{Field: "value", Op: OpGte, Value: test.value})
+			if err != nil || !reflect.DeepEqual(got, test.want) {
+				t.Fatalf("comparison = (%#v, %v), want %#v", got, err, test.want)
+			}
+		})
+	}
+	values := []json.Number{"9007199254740993", "1.25"}
+	got, err := NormalizeFilterValue(Filter{Field: "value", Op: OpIn, Value: values})
+	if err != nil || !reflect.DeepEqual(got, []any{int64(9007199254740993), 1.25}) {
+		t.Fatalf("membership = (%#v, %v)", got, err)
+	}
+	if !reflect.DeepEqual(values, []json.Number{"9007199254740993", "1.25"}) {
+		t.Fatalf("membership modified caller values: %v", values)
+	}
+}
+
+func TestNormalizeFilterJSONNumbersRejectInvalidValues(t *testing.T) {
+	for _, text := range []string{
+		"", "01", "+1", "NaN", "Infinity", "null", "true", `"1"`, "[1]", " 1 ",
+		"1e309", "-9223372036854775809", "18446744073709551616",
+	} {
+		t.Run(text, func(t *testing.T) {
+			for _, op := range []Op{OpEq, OpGt, OpIn} {
+				var value any = json.Number(text)
+				if op == OpIn {
+					value = []any{1, value}
+				}
+				_, err := NormalizeFilterValue(Filter{Field: "value", Op: op, Value: value})
+				if !errors.Is(err, ErrInvalidQuery) {
+					t.Fatalf("%s comparison error = %v, want ErrInvalidQuery", op, err)
+				}
+			}
+		})
+	}
+}
